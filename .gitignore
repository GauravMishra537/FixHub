
# FixHub .gitignore

# Environment and secrets

.env
.env.local
.env.development
.env.production
*.pem
*.key
*.p12
*.jks


# Java / Maven
backend/target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*
replay_pid*

backend/.mvn/wrapper/maven-wrapper.jar


# Node / npm
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# IDE — IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# IDE — VS Code
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db


# Uploaded files and storage
uploads/
storage/
temp/


# Test and coverage reports
frontend/coverage/
backend/coverage/
*.lcov
.nyc_output/

# Docker (optional, future use)
docker-compose.override.yml


# Miscellaneous
*.swp
*.swo
*~
.cache/
commit-reports