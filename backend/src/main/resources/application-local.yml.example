# FixHub — Local Environment Template
# Copy this file to application-local.yml and fill in your local secrets.
# application-local.yml is ignored by git and will never be committed.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/fixhub
    username: postgres
    password: your_database_password

  mail:
    host: smtp.gmail.com
    port: 587
    username: your_email@gmail.com
    password: your_app_password
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

app:
  mail:
    from: your_email@gmail.com
