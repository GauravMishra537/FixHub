# FixHub — Environment Variables Template
# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fixhub
DB_USERNAME=gaurav
DB_PASSWORD=Gaurav@123

# Spring datasource (derived from above, used by Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fixhub
SPRING_DATASOURCE_USERNAME=gaurav
SPRING_DATASOURCE_PASSWORD=Gaurav@123

# Flyway (used for database migrations)
FLYWAY_URL=jdbc:postgresql://localhost:5432/fixhub
FLYWAY_USER=gaurav
FLYWAY_PASSWORD=Gaurav@123


# JWT / Session Secrets
JWT_SECRET=YnmHd2Lm/HtzHdo29uvWctHV5c2eJP4Of7fVgQnrI0w=
JWT_EXPIRATION_MS=86400000


# Google OAuth 2.0 (configure when implementing Commit 8)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Email / SMTP (configure when implementing Commit 6)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email_here
MAIL_PASSWORD=your_email_password_here
MAIL_FROM=noreply@fixhub.local


# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20


# Backend Server
SERVER_PORT=8080


# Frontend (used by Vite — prefix with VITE_)
VITE_API_BASE_URL=http://localhost:8080/api
